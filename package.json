{
  "name": "@totp-generator/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "postinstall": "pnpm run typegen",
    "build": "pnpm --filter @totp-generator/web build && pnpm run verify:tailwind",
    "predeploy": "pnpm run build",
    "verify:tailwind": "tsx scripts/verify-tailwind-kit.ts",
    "checks": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:god-files && pnpm run test:coverage && pnpm run test:web:coverage",
    "prettier": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:test && pnpm run typecheck:functions && pnpm run typecheck:scripts",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "vitest run --config vitest.web.config.mts",
    "test:web:coverage": "vitest run --config vitest.web.config.mts --coverage",
    "check:god-files": "tsx node_modules/@rexezuge/tooling/src/scripts/check-god-files.ts --fail-on-hard",
    "lint": "eslint --fix --quiet .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv",
    "prepare-config": "tsx scripts/prepare-wrangler-config.ts",
    "dev": "wrangler dev",
    "deploy:dry-run": "pnpm run prepare-config && wrangler deploy --dry-run",
    "deploy": "pnpm run prepare-config && wrangler deploy"
  },
  "devDependencies": {
    "@rexezuge/errors": "1.9.2",
    "@rexezuge/http": "1.9.2",
    "@rexezuge/runtime": "1.9.2",
    "@rexezuge/shared": "1.9.2",
    "@rexezuge/tooling": "1.9.2",
    "@rexezuge/web": "1.9.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0",
    "zod": "4.6.7"
  }
}
