{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totp-generator",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  // The SPA is served from the same worker deployment, assets-first: a request
  // that matches a built file is answered by the platform, everything else runs
  // the worker (the API routes and the JSON 404).
  "assets": {
    "directory": "apps/web/dist",
  },
}
